root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[{justfile,go.mod,go.sum,*.go,.gitmodules}]
indent_style = tab

[*.yaml]
indent_size = 2

[*.md]
indent_size = 4
trim_trailing_whitespace = false

[*.el]
# checker complains when spaces are used for alignment otherwise
indent_size = 1
