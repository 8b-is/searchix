package components

import (
	"go.alanpearce.eu/searchix/internal/index"
	"strconv"
)

templ score(h index.DocumentMatch) {
	<a class="open-sibling-dialog">
		{ strconv.FormatFloat(h.Score, 'f', 2, 64) }
	</a>
	<dialog>
		<button autofocus>Close</button>
		<pre>
			{ h.Expl.String() }
		</pre>
	</dialog>
}
