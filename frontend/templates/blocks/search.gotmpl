{{- define "main" }}
  <form id="search">
    <label for="query">{{ .Source.Name }} option search</label>
    <fieldset>
      <input id="query" name="query" type="search" value="{{ .Query }}" />
      <button>Search</button>
    </fieldset>
  </form>
  {{- if .Results }}
    {{ block "results" . }}{{ end }}
  {{- end }}
{{- end }}

{{- define "js" }}
  <script src="/static/search.js" defer></script>
{{- end }}
