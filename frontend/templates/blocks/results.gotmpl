{{- define "results" }}
  {{- with .Results }}
    {{- if gt .Total 0 }}
      {{ block "hits" .Hits }}
      {{ end }}
      <footer aria-label="pagination">
        <nav id="pagination">
          {{- with $.Prev }}
            <a class="button" href="{{ . }}" rel="prev">Prev</a>
          {{- end }}
          {{- with $.Next }}
            <a class="button" href="{{ . }}" rel="next">Next</a>
          {{- end }}
        </nav>
        <span role="status">{{ .Total }} results</span>
      </footer>
    {{- else }}
      <span role="status">Nothing found</span>
    {{- end }}
  {{- end }}
{{- end }}
