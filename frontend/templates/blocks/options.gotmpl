{{- define "hits" }}
  <table>
    <thead>
      <tr>
        <th scope="col">Title</th>
        <th scope="col">Description</th>
      </tr>
    </thead>
    <tbody>
      {{- range . }}
        {{- with .Data }}
          <tr>
            <td>
              <a href="{{ .Name }}" class="open-dialog">{{ .Name }}</a>
            </td>
            <td>
              {{ markdown (firstSentence .Description) }}
              <dialog id="{{ .Name }}"></dialog>
            </td>
          </tr>
        {{- end }}
      {{- end }}
    </tbody>
  </table>
{{- end }}
