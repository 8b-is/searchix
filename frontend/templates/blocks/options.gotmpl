{{ define "results" }}
  {{- range .Results }}
    <details id="{{ .Option }}">
      <summary>
        {{ .Option }}
      </summary>
      <p>
        {{ markdown .Description }}
      </p>
      <dl>
        {{- with .Type }}
          <dt>Type</dt>
          <dd><code>{{ . }}</code></dd>
        {{- end }}
        {{- with .Default }}
          <dt>Default</dt>
          <dd>
            {{- if .Markdown }}
              {{ .Markdown }}
            {{- else }}
              <pre><code>{{ .Text }}</code></pre>
            {{- end }}
          </dd>
        {{- end }}
        {{- with .Example }}
          {{- if or .Text .Markdown }}
            <dt>Example</dt>
            <dd>
              {{- if .Markdown }}
                {{ .Markdown }}
              {{- else }}
                <pre><code>{{ .Text }}</code></pre>
              {{- end }}
            </dd>
          {{- end }}
        {{- end }}
        {{- with .RelatedPackages }}
          <dt>Related Packages</dt>
          <dd>{{ . }}</dd>
        {{- end }}
        {{- with .Declarations }}
          <dt>Declared</dt>
          {{- range . }}
            <dd>
              <a href="{{ .URL }}">{{ .Name }}</a>
            </dd>
          {{- end }}
        {{- end }}
      </dl>
    </details>
  {{- end }}
{{ end }}
