{{ define "results" }}
  {{- range .Results }}
    <details id="{{ .Option }}">
      <summary>
        {{ .Option }}
      </summary>
      <p>
        {{ HTML .Description.HTML }}
      </p>
      <dl>
        {{- with .Type }}
          <dt>Type</dt>
          <dd>{{ . }}</dd>
        {{- end }}
        {{- with .Default }}
          <dt>Default</dt>
          <dd><code>{{ .Text }}</code></dd>
        {{- end }}
        {{- with .Example }}
          {{- if .Text }}
            <dt>Example</dt>
            <dd><code>{{ .Text }}</code></dd>
          {{- end }}
        {{- end }}
        {{- with .RelatedPackages.HTML }}
          <dt>Related Packages</dt>
          <dd>{{ . }}</dd>
        {{- end }}
        {{- with .Declarations }}
          <dt>Declared</dt>
          {{- range . }}
            <dd>
              <a href="file://{{ . }}">{{ . }}</a>
            </dd>
          {{- end }}
        {{- end }}
      </dl>
    </details>
  {{- end }}
{{ end }}
